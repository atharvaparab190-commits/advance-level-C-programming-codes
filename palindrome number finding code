#include <stdio.h>

int main()
{
    int num, temp, count = 0;
    int rev = 0, rem;

    printf("Enter a number: ");
    scanf("%d", &num);

    temp = num;

    do
    {
        count++;
        temp = temp / 10;
    }
    while (temp != 0);

    printf("Number of digits = %d\n", count);

    temp = num;

    do
    {
        rem = num % 10;
        rev = rev * 10 + rem;
        num = num / 10;
    }
    while (num != 0);

    if (temp == rev)
        printf("%d is a Palindrome Number\n", temp);
    else
        printf("%d is Not a Palindrome Number\n", temp);

    return 0;
}
