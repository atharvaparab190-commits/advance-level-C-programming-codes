#include <stdio.h>

struct Student
{
    char name[50];
    int age;
    float marks;
};

int main()
{
    int n, i, topper = 0;

    printf("Enter the number of students: ");
    scanf("%d", &n);

    struct Student s[n];

    for(i = 0; i < 5; i++)
    {
        printf("\nEnter details of Student %d\n", i + 1);

        printf("Enter Name: ");
        scanf("%s", s[i].name);

        printf("Enter Age: ");
        scanf("%d", &s[i].age);

        printf("Enter Marks: ");
        scanf("%f", &s[i].marks);
    }

    for(i = 1; i < 5; i++)
    {
        if(s[i].marks > s[topper].marks)
        {
            topper = i;
        }
    }

    printf("\n===== Topper Details =====\n");
    printf("Name  : %s\n", s[topper].name);
    printf("Age   : %d\n", s[topper].age);
    printf("Marks : %.2f\n", s[topper].marks);

    return 0;
}
